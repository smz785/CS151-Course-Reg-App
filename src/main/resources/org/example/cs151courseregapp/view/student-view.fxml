<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.TextField?>
<AnchorPane prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.cs151courseregapp.controller.StudentController">
    <children>
        <BorderPane prefHeight="600.0" prefWidth="1000.0">
            <left>
                <BorderPane prefHeight="600.0" prefWidth="250.0" BorderPane.alignment="CENTER">

                    <top>
                        <VBox spacing="8.0" alignment="TOP_CENTER">
                            <children>
                                <HBox spacing="5.0" prefHeight="35.0" prefWidth="250.0" alignment="CENTER_LEFT">
                                    <padding>
                                        <Insets left="5.0" right="5.0" />
                                    </padding>

                                    <Button mnemonicParsing="false"
                                            onAction="#goBackToMain"
                                            text="← Back"
                                            prefWidth="60.0" />

                                    <Button fx:id="dropSelectedButton"
                                            mnemonicParsing="false"
                                            onAction="#dropSelectedClass"
                                            text="Drop"
                                            prefWidth="70.0"
                                            style="-fx-background-color: #d9534f; -fx-text-fill: white;" />

                                    <Label text="My Classes" textAlignment="CENTER">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                </HBox>

                                <HBox spacing="8.0" alignment="CENTER">
                                    <Label text="Student ID:" />
                                    <TextField fx:id="studentIdField"
                                               promptText="Enter std id"
                                               prefWidth="95.0" />
                                    <Button text="Load"
                                            onAction="#loadStudentById" />
                                </HBox>
                            </children>
                        </VBox>
                    </top>

                    <center>
                        <ListView fx:id="classesListView"
                                  prefWidth="250.0" />
                    </center>


                </BorderPane>
            </left>
            <center>
                <VBox prefHeight="600.0" prefWidth="800.0" BorderPane.alignment="CENTER">
                    <children>
                        <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="750.0" text="Available Classes" textAlignment="CENTER">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TableView fx:id="coursesTable" prefWidth="750.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="courseColumn" prefWidth="120.0" text="Course" />
                                <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
                                <TableColumn fx:id="instructorColumn" prefWidth="150.0" text="Instructor" />
                                <TableColumn fx:id="typeColumn" prefWidth="100.0" text="Type" />
                                <TableColumn fx:id="locationColumn" prefWidth="120.0" text="Location" />
                                <TableColumn fx:id="roomColumn" prefWidth="200.0" text="Room or Link" />
                                <TableColumn fx:id="timeslotColumn" minWidth="120.0" prefWidth="120.0" text="Timeslot" />
                                <TableColumn fx:id="capacityColumn" prefWidth="100.0" text="Capacity" />
                                <TableColumn fx:id="actionColumn" prefWidth="75.0" text="Action" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>