<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.cs151courseregapp.controller.ProfessorController">
   <children>
      <BorderPane prefHeight="600.0" prefWidth="1000.0">
         <left>
            <VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="250.0" BorderPane.alignment="CENTER">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="250.0" text="My Classes" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <ListView fx:id="classesListView" prefHeight="570.0" prefWidth="250.0" />
               </children>
            </VBox>
         </left>
         <center>
            <VBox prefHeight="600.0" prefWidth="800.0" BorderPane.alignment="CENTER">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="750.0" text="Available Classes" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <TableView fx:id="coursesTable" prefWidth="750.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="courseColumn" prefWidth="120.0" text="Course" />
                        <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
                      <TableColumn fx:id="instructorColumn" prefWidth="150.0" text="Instructor" />
                      <TableColumn fx:id="typeColumn" prefWidth="100.0" text="Type" />
                        <TableColumn fx:id="locationColumn" prefWidth="120.0" text="Location" />
                        <TableColumn fx:id="roomColumn" prefWidth="200.0" text="Room or Link" />
                        <TableColumn fx:id="timeslotColumn" minWidth="120.0" prefWidth="120.0" text="Timeslot" />
                        <TableColumn fx:id="capacityColumn" prefWidth="100.0" text="Capacity" />
                        <TableColumn fx:id="actionColumn" prefWidth="75.0" text="Action" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
